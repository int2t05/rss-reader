# AI provider (OpenAI-compatible: OpenAI / Claude / Gemini / DeepSeek / Doubao / MiniMax / Ollama)
OPENAI_API_KEY=sk-your-key
# Optional: custom base URL for non-OpenAI providers (e.g. https://api.deepseek.com/v1)
# OPENAI_BASE_URL=
# Optional: model override (default from data/config.json)
# OPENAI_MODEL=

# Self-built video source (FluxSift),经 cpolar 隧道转发;部署后填写
FLUXSIFT_TOKEN=
FLUXSIFT_FEED_URL=http://127.0.0.1:8765/feed

# Optional RSSHub base URL (leave blank to skip RSSHub-prefixed sources like /solidot, /bilibili/...)
RSSHUB_BASE_URL=
