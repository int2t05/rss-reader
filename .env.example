# AI provider (OpenAI-compatible: OpenAI / Claude / Gemini / DeepSeek / Doubao / MiniMax / Ollama)
OPENAI_API_KEY=sk-your-key
# Optional: custom base URL for non-OpenAI providers (e.g. https://api.deepseek.com/v1)
# OPENAI_BASE_URL=

# Optional search/fetch backend keys (leave blank to use zero-config fallback)
EXA_API_KEY=
FIRECRAWL_API_KEY=

# Self-built sources (FluxSift + auto-trend RSS tokens)
FLUXSIFT_TOKEN=
FLUXSIFT_FEED_URL=http://127.0.0.1:8765/feed
AUTOTREND_FEED_URL=

# Optional RSSHub base URL (leave blank to skip RSSHub-prefixed sources)
RSSHUB_BASE_URL=
